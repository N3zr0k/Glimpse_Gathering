# Ein Addon-Ordner im Repo (Glimpse_Gathering/), alles andere liegt daneben. Der Packager baut im Ordner
# Glimpse_Gathering, schiebt den Inhalt des Addon-Ordners eine Ebene hoch; was außen liegt, bleibt über "ignore" draußen.
package-as: Glimpse_Gathering

move-folders:
  Glimpse_Gathering/Glimpse_Gathering: Glimpse_Gathering

# Beziehungen auf CurseForge (Kurznamen der Projekte); externe Addons werden nicht gemeldet
required-dependencies:
  - glimpse

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - tests
  - docs
  - tools
  - .github
  - .luacheckrc
  - .gitattributes
  - .gitignore
  - DEVELOPER.md
  - README.md
  - LICENSE
  - CHANGELOG.md
