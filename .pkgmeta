# Ein Repo, zwei Addons: Der Packager baut alles in einen Ordner Glimpse_Gathering und
# verschiebt die beiden Addon-Ordner danach auf die oberste Ebene des ZIPs. LICENSE und CHANGELOG
# des Repos bleiben draußen (jeder Addon-Ordner hat seine eigene LICENSE), sonst bliebe ein leerer
# Ordner Glimpse_Gathering im ZIP.
package-as: Glimpse_Gathering

move-folders:
  Glimpse_Gathering/Glimpse_GatheringDB: Glimpse_GatheringDB
  Glimpse_Gathering/Glimpse_GatheringTooltip: Glimpse_GatheringTooltip

# Beziehungen auf CurseForge (Kurznamen der Projekte); externe Addons werden nicht gemeldet
required-dependencies:
  - glimpse

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - tests
  - docs
  - tools
  - .github
  - .luacheckrc
  - .gitattributes
  - .gitignore
  - DEVELOPER.md
  - README.md
  - LICENSE
  - CHANGELOG.md
